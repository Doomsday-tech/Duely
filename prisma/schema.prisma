datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  things       Thing[]
  categories   Category[]
  documents    Document[]
  reminders    Reminder[]
  actions      Action[]
  renewals     RenewalHistory[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String?  // null if system default category
  name      String
  color     String?  // subtle accent token
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  things    Thing[]

  @@unique([userId, name])
}

model Thing {
  id              String           @id @default(uuid())
  userId          String
  categoryId      String?
  name            String
  description     String?
  purchaseDate    DateTime?
  expiryDate      DateTime?
  renewalDate     DateTime?
  status          String           @default("ACTIVE") // ACTIVE, DUE_SOON, URGENT, EXPIRED, OVERDUE, RENEWED
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  documents       Document[]
  reminders       Reminder[]
  actions         Action[]
  renewalHistory  RenewalHistory[]

  @@index([userId])
  @@index([expiryDate])
  @@index([status])
}

model Document {
  id            String    @id @default(uuid())
  userId        String
  thingId       String?
  filename      String
  originalName  String
  mimeType      String
  size          Int
  filePath      String
  documentType  String?   // "INVOICE", "POLICY", "PASSPORT", "WARRANTY", "CONTRACT", "CERTIFICATE", "OTHER"
  issueDate     DateTime?
  expiryDate    DateTime?
  identifier    String?   // policy number, serial number, etc.
  extractedMeta String?   // JSON string of detected metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  thing         Thing?    @relation(fields: [thingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([thingId])
}

model Reminder {
  id          String    @id @default(uuid())
  userId      String
  thingId     String
  daysBefore  Int       // 7, 14, 30, 60, or custom offset
  customDate  DateTime?
  remindAt    DateTime  // calculated trigger date
  channel     String    @default("IN_APP") // IN_APP, EMAIL
  status      String    @default("PENDING") // PENDING, TRIGGERED, DISMISSED
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  thing       Thing     @relation(fields: [thingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([thingId])
  @@index([remindAt, status])
}

model Action {
  id          String    @id @default(uuid())
  userId      String
  thingId     String
  title       String    // e.g. "Renew insurance", "Contact manufacturer"
  actionUrl   String?
  notes       String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  thing       Thing     @relation(fields: [thingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([thingId])
}

model RenewalHistory {
  id             String    @id @default(uuid())
  userId         String
  thingId        String
  previousExpiry DateTime?
  newExpiry      DateTime
  renewedAt      DateTime  @default(now())
  cost           Float?
  notes          String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  thing          Thing     @relation(fields: [thingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([thingId])
}
